# Metode login: "qr" atau "pairing"
# Kosongkan jika ingin dipilih manual lewat console panel saat start pertama.
LOGIN_METHOD=pairing

# Nomor HP untuk pairing code (hanya dipakai jika LOGIN_METHOD=pairing)
# Format: kode negara + nomor, tanpa "+", tanpa spasi. Contoh: 6281234567890
PHONE_NUMBER=6281234567890

# ============ Owner bot (WAJIB) ============
# 1-2 nomor owner, digit saja (tanpa "+", tanpa spasi), pisah koma.
# Semua nomor di sini punya hak admin penuh (command owner, $ shell, dsb).
# Kosong = bot MENOLAK start. Nomor pertama = owner utama (vCard .owner,
# target notifikasi error AI, fallback link .menu).
OWNER_NUMBERS=6281234567890

# ============ API Key AI (opsional) ============
# Isi HANYA untuk provider yang mau dipakai (fitur .ai & trigger natural).
# Provider/model AKTIF disimpan di SQLite (data/ai.db), diganti kapan saja
# lewat command .ai provider / .ai model — tanpa deploy ulang.
# Tanpa key untuk provider aktif, chat AI gagal (command lain tetap jalan).

# Google Gemini (provider "google")
AI_API_KEY=

# OpenRouter (provider "openrouter") — https://openrouter.ai
OPENROUTER_API_KEY=

# NexaRouter (provider "nexarouter") — https://router.nexaworks.web.id
# Tools dicoba dikirim; kalau server menolak, otomatis fallback chat teks.
NEXAROUTER_API_KEY=

# Ciora AI (provider "ciora") — https://ciora.id
# OpenAI-compatible + mendukung tool-calling standar OpenAI.
CIORA_API_KEY=

# ============ Kartu link .menu (opsional) ============
# Semua boleh kosong (= default otomatis). THUMB_URL & FAVICON_URL wajib
# URL gambar LANGSUNG (bukan halaman web), atau kartu tampil tanpa gambar.
#MENU_LINK=https://wa.me/6281234567890
#MENU_TITLE=Flora GO v1.1.0
#MENU_DESC=Bot WhatsApp serbaguna
#MENU_THUMB_URL=https://contoh/banner.jpg
#MENU_FAVICON_URL=https://contoh/favicon.jpg
