# Metode login: WAJIB "qr" atau "pairing" (tidak boleh kosong — bot panic
# bila bukan salah satunya, karena panel tidak bisa menunggu input console).
LOGIN_METHOD=pairing

# Nomor HP untuk pairing code (hanya dipakai jika LOGIN_METHOD=pairing)
# Format: kode negara + nomor, tanpa "+", tanpa spasi. Contoh: 6281234567890
PHONE_NUMBER=6281234567890

# ============ Owner bot (WAJIB) ============
# 1-2 nomor owner, digit saja (tanpa "+", tanpa spasi), pisah koma.
# Semua nomor di sini punya hak admin penuh (command owner, $ shell, dsb).
# Kosong = bot MENOLAK start. Nomor pertama = owner utama (vCard .owner,
# target notifikasi error AI, fallback link .menu).
OWNER_NUMBERS=6281234567890

# ============ API Key AI (opsional) ============
# Isi HANYA untuk provider yang mau dipakai (fitur .ai & trigger natural).
# Provider/model AKTIF disimpan di SQLite (data/ai.db), diganti kapan saja
# lewat command .ai provider / .ai model — tanpa deploy ulang.
# Tanpa key untuk provider aktif, chat AI gagal (command lain tetap jalan).

# API key provider AI — aturan seragam <NAMA>_API_KEY (huruf besar).
# Provider & model dikelola lewat command (.agent provider/model add/del);
# yang perlu di sini hanya key-nya. Tanpa key untuk provider aktif, chat
# AI gagal (command lain tetap jalan).

# Ciora AI (provider "ciora") — https://ciora.id
# OpenAI-compatible + mendukung tool-calling standar OpenAI.
CIORA_API_KEY=

# OpenAgentic (provider "openagentic") — https://openagentic.id
# OpenAI-compatible (tools + vision). Daftar + isi key lalu
# `.agent provider openagentic`.
OPENAGENTIC_API_KEY=

# Batas tunggu SATU request ke provider AI (format durasi Go: 150s, 3m).
# Default 150s. Model reasoning di free tier bisa butuh >60 detik untuk satu
# jawaban; terlalu kecil = "context deadline exceeded" padahal provider sehat.
#AI_REQUEST_TIMEOUT=150s

# ============ Kartu link .menu (opsional) ============
# Semua boleh kosong (= default otomatis). THUMB_URL & FAVICON_URL wajib
# URL gambar LANGSUNG (bukan halaman web), atau kartu tampil tanpa gambar.
#MENU_LINK=https://wa.me/6281234567890
#MENU_TITLE=Flora GO v1.1.0
#MENU_DESC=Bot WhatsApp serbaguna
#MENU_THUMB_URL=https://contoh/banner.jpg
#MENU_FAVICON_URL=https://contoh/favicon.jpg

# ============ Zona waktu bot (opsional) ============
# Nama zona IANA, mis. Asia/Makassar (WITA), Asia/Jakarta (WIB),
# Asia/Jayapura (WIT). Alias lama WIB/WITA/WIT masih diterima.
# Kosong = Asia/Makassar. Ubah file ini lalu restart bot.
BOT_TIMEZONE=Asia/Makassar

# ============ Voice note (.tts / .vn / mode suara Flora) ============
# Edge Read Aloud adalah sumber utama. Kalau Edge menolak (token DRM diganti,
# IP diblokir), bot otomatis memakai Google Translate TTS sebagai cadangan.
# Set 0 untuk mematikan cadangan itu (bot hanya melapor gagal).
#TTS_GOOGLE_FALLBACK=0

# ============ Diagnostik & observabilitas (opsional, default mati/ringan) ============
# pprof (CPU/mem/goroutine). Kosong = mati. Contoh: 127.0.0.1:6060
#PPROF_ADDR=
# Interval log metrik (5m default). Format durasi Go. "off"/"0" mematikan.
#METRICS_LOG_INTERVAL=5m

# ============ Kendali beban (opsional) ============
# Transcode ffmpeg paralel (1-4, default 1). Panel 1 core: biarkan 1.
#HEAVY_MAX_PAR=1
# Lama antre slot transcode (default 30s).
#HEAVY_QUEUE_TIMEOUT=30s
# Download bersamaan (1-8, default 2).
#DL_MAX_PAR=2

# ============ Rate limit API eksternal (opsional) ============
# Laju request per engine (req/detik, default 10, cap 50).
#EXTERNAL_RATE_RPS=10

# ============ Chat Gemini web (.gemini, owner) ============
# Sesi memakai cookie akun Google khusus bot di data/gemini-cookie.txt
# (diisi lewat `.gemini login <cookie>`), bukan API key. Riwayat percakapan
# disimpan di server Gemini; bot hanya menyimpan cookie + pointer di memori.
# Model teks: lite (generasi paling singkat), flash, pro.
#GEMINI_MODEL_TEXT=lite
# 1 = mode berpikir diperluas (lebih lambat, jawaban lebih teliti).
#GEMINI_THINKING=0
# Batas ukuran lampiran yang boleh diunggah ke Gemini (MB, default 20).
#GEMINI_MAX_UPLOAD_MB=20
# Unduh gambar hasil Gemini: kalau semua percobaan HTTP ditolak 403, bot
# menyalakan Chrome sebentar. Path binary bisa ditimpa (opsional); GEMINI_HEADED=0
# memaksa headless (default: headed + Xvfb bila Xvfb ada).
#GEMINI_CHROME_PATH=/usr/bin/google-chrome
#GEMINI_XVFB_PATH=/usr/bin/Xvfb
#GEMINI_HEADED=0
# Catatan: pembacaan stream, transport (IPv4 + HTTP/2), dan batas diam 4 dtk
# adalah konstanta di internal/geminiapi — tidak diatur lewat env.

# ============ Log AI penuh (opsional) ============
# 1 = setiap request AI + eksekusi tool dicatat UTUH ke console (pemantauan).
# 0 = kembali ringkas (satu baris potong). Kosong = 1.
AI_LOG_FULL=1
